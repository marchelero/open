{
  "version": 1,
  "mode": "enforce",
  "description": "Declarative tool-call policy for the open pack. Edit this file to change enforcement without touching JS. severity: warn (log + console.warn, never blocks) | ask (native permission.ask prompt, degrades to warn if the event does not fire for bash) | deny (throws in tool.execute.before, blocks the call). Default is conservative: only catastrophic/irreversible operations are deny.",
  "confinement": {
    "mode": "audit",
    "roots": ["."],
    "allow": [],
    "readTools": ["edit", "write", "read"],
    "denyNetwork": false
  },
  "rules": [
    {
      "id": "fs-rm-rf-abs",
      "severity": "deny",
      "match": "\\brm\\s+(-\\w*r\\w*\\s+)*-\\w*f\\w*\\s+\\/\\S*",
      "tool": "bash",
      "message": "rm -rf on an absolute path can destroy the OS or the whole workspace irreversibly."
    },
    {
      "id": "fs-rm-rf-home",
      "severity": "deny",
      "match": "\\brm\\s+-\\w*r\\w*f\\w*\\s+~",
      "tool": "bash",
      "message": "rm -rf on the home directory is irreversible."
    },
    {
      "id": "fs-rm-rf-parent",
      "severity": "warn",
      "match": "\\brm\\s+-\\w*r\\w*f\\w*\\s+\\.\\.\\/",
      "tool": "bash",
      "message": "rm -rf on a parent directory; confirm the target before continuing."
    },
    {
      "id": "fs-wipe-dev",
      "severity": "deny",
      "match": ">\\s*\\/dev\\/(sd[a-z]|nvme\\d+n\\d+|disk)",
      "tool": "bash",
      "message": "Overwriting a raw block device destroys the disk irreversibly."
    },
    {
      "id": "fs-mkfs",
      "severity": "deny",
      "match": "\\bmkfs\\.",
      "tool": "bash",
      "message": "mkfs formats a filesystem and destroys its contents irreversibly."
    },
    {
      "id": "fs-dd-dev",
      "severity": "deny",
      "match": "\\bdd\\s+if=.*\\s+of=\\/dev\\/",
      "tool": "bash",
      "message": "dd writing to a raw device destroys the target irreversibly."
    },
    {
      "id": "fs-fork-bomb",
      "severity": "deny",
      "match": ":\\(\\)\\s*\\{\\s*:\\|:\\&\\s*\\}\\s*;\\s*:",
      "tool": "bash",
      "message": "Fork bomb; it will exhaust the machine."
    },
    {
      "id": "win-del-recursive",
      "severity": "deny",
      "match": "\\b(del|erase)\\b[^\\n]*\\/s\\b",
      "tool": "bash",
      "flags": "i",
      "message": "del/erase /s recursively deletes files on Windows; irreversible for the tree."
    },
    {
      "id": "win-del-force-quiet",
      "severity": "warn",
      "match": "\\b(del|erase)\\b[^\\n]*\\/(f|q)\\b",
      "tool": "bash",
      "flags": "i",
      "message": "del with /f or /q force-deletes or silences prompts; confirm the target."
    },
    {
      "id": "win-remove-item-recurse",
      "severity": "deny",
      "match": "\\b(remove-item|ri)\\b[^\\n]*-(recurse|r)\\b",
      "tool": "bash",
      "flags": "i",
      "message": "Remove-Item -Recurse deletes a whole tree on Windows."
    },
    {
      "id": "win-remove-item-force",
      "severity": "warn",
      "match": "\\b(remove-item|ri)\\b[^\\n]*-(force|fo)\\b",
      "tool": "bash",
      "flags": "i",
      "message": "Remove-Item -Force removes read-only/hidden files; confirm."
    },
    {
      "id": "win-rmdir-s",
      "severity": "deny",
      "match": "\\b(rmdir|rd)\\b[^\\n]*\\/s\\b",
      "tool": "bash",
      "flags": "i",
      "message": "rmdir /s deletes a directory tree on Windows."
    },
    {
      "id": "win-format-drive",
      "severity": "deny",
      "match": "\\bformat\\s+[a-z]:",
      "tool": "bash",
      "flags": "i",
      "message": "format erases a Windows drive."
    },
    {
      "id": "win-diskpart",
      "severity": "deny",
      "match": "\\bdiskpart\\b",
      "tool": "bash",
      "flags": "i",
      "message": "diskpart can wipe partitions and disks."
    },
    {
      "id": "win-clear-disk",
      "severity": "deny",
      "match": "\\b(clear-disk|format-volume|remove-partition)\\b",
      "tool": "bash",
      "flags": "i",
      "message": "PowerShell storage cmdlet that wipes a disk or partition."
    },
    {
      "id": "win-vssadmin-delete",
      "severity": "deny",
      "match": "\\bvssadmin\\b[^\\n]*\\bdelete\\b[^\\n]*\\bshadows\\b",
      "tool": "bash",
      "flags": "i",
      "message": "deleting shadow copies destroys backups/restore points."
    },
    {
      "id": "win-stop-computer",
      "severity": "ask",
      "match": "\\bstop-computer\\b",
      "tool": "bash",
      "flags": "i",
      "message": "Stop-Computer powers off the machine; confirm it is intended."
    },
    {
      "id": "win-restart-computer",
      "severity": "ask",
      "match": "\\brestart-computer\\b",
      "tool": "bash",
      "flags": "i",
      "message": "Restart-Computer restarts the machine; confirm it is intended."
    },
    {
      "id": "git-push-force",
      "severity": "deny",
      "match": "\\bgit\\s+push\\b[^\\n]*--force(\\s|$)",
      "tool": "bash",
      "message": "git push --force can rewrite shared remote history irreversibly."
    },
    {
      "id": "git-push-f",
      "severity": "deny",
      "match": "\\bgit\\s+push\\b[^\\n]*\\s-f(\\s|$)",
      "tool": "bash",
      "message": "git push -f can rewrite shared remote history irreversibly."
    },
    {
      "id": "git-reset-hard",
      "severity": "warn",
      "match": "\\bgit\\s+reset\\s+--hard",
      "tool": "bash",
      "message": "git reset --hard discards local changes; recoverable via reflog if caught early."
    },
    {
      "id": "git-clean-fd",
      "severity": "warn",
      "match": "\\bgit\\s+clean\\s+-\\w*f\\w*d\\w*",
      "tool": "bash",
      "message": "git clean -fd deletes untracked files; confirm the target."
    },
    {
      "id": "git-branch-force-delete",
      "severity": "warn",
      "match": "\\bgit\\s+branch\\s+-\\w*D\\w*",
      "tool": "bash",
      "message": "git branch -D force-deletes a branch even if unmerged."
    },
    {
      "id": "git-update-ref-d",
      "severity": "warn",
      "match": "\\bgit\\s+update-ref\\s+-d",
      "tool": "bash",
      "message": "git update-ref -d deletes a ref directly; confirm the target."
    },
    {
      "id": "db-drop-database",
      "severity": "deny",
      "match": "\\bDROP\\s+(DATABASE|SCHEMA)\\b",
      "tool": "bash",
      "flags": "i",
      "message": "DROP DATABASE/SCHEMA destroys the whole schema irreversibly."
    },
    {
      "id": "db-drop-table",
      "severity": "warn",
      "match": "\\bDROP\\s+TABLE\\b",
      "tool": "bash",
      "flags": "i",
      "message": "DROP TABLE is legitimate in migrations; warn, do not block."
    },
    {
      "id": "db-truncate",
      "severity": "warn",
      "match": "\\bTRUNCATE(\\s+TABLE)?\\s+\\w+",
      "tool": "bash",
      "flags": "i",
      "message": "TRUNCATE removes all rows; legitimate in migrations, warn only."
    },
    {
      "id": "db-delete-no-where",
      "severity": "warn",
      "match": "\\bDELETE\\s+FROM\\s+\\w+\\s*;",
      "tool": "bash",
      "flags": "i",
      "message": "DELETE FROM without WHERE deletes every row; confirm before running."
    },
    {
      "id": "sys-shutdown",
      "severity": "ask",
      "match": "\\bshutdown\\b",
      "tool": "bash",
      "message": "shutdown stops the machine; confirm it is intended."
    },
    {
      "id": "sys-reboot",
      "severity": "ask",
      "match": "\\breboot\\b",
      "tool": "bash",
      "message": "reboot restarts the machine; confirm it is intended."
    },
    {
      "id": "sys-halt",
      "severity": "ask",
      "match": "\\bhalt\\b",
      "tool": "bash",
      "message": "halt powers off the machine; confirm it is intended."
    },
    {
      "id": "protect-linter-config",
      "severity": "warn",
      "tool": ["edit", "write"],
      "flags": "i",
      "match": "(^|[/\\\\])(\\.eslintrc.*|eslint\\.config\\..*|\\.eslintignore|\\.prettierrc.*|prettier\\.config\\..*|\\.prettierignore|\\.stylelintrc.*|stylelint\\.config\\..*|\\.stylelintignore|commitlint\\.config\\..*|\\.commitlintrc.*|biome\\.jsonc?|\\.biome\\.jsonc?|\\.?ruff\\.toml|\\.markdownlint.*)$",
      "message": "Editing a linter/formatter/commit-lint config can silently weaken the whole repo's checks. Fix the code, not the gate; if the change is intentional, confirm it."
    },
    {
      "id": "git-commit-no-verify",
      "severity": "ask",
      "tool": "bash",
      "match": "\\bgit\\s+commit\\b[^\\n]*--no-verify",
      "message": "git commit --no-verify skips pre-commit hooks; bypassing the checks is rarely intended. Confirm before running."
    },
    {
      "id": "git-push-no-verify",
      "severity": "ask",
      "tool": "bash",
      "match": "\\bgit\\s+push\\b[^\\n]*--no-verify",
      "message": "git push --no-verify skips pre-push hooks; bypassing the checks is rarely intended. Confirm before running."
    },
    {
      "id": "git-hooks-path-override",
      "severity": "ask",
      "tool": "bash",
      "match": "\\bgit\\b[^\\n]*core\\.hooksPath",
      "message": "Overriding core.hooksPath disables the repository's git hooks for this command. Confirm before running."
    }
  ]
}
